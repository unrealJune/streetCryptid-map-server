+  /**
+   * streetcryptid: OSM land cover starts at z5, not upstream's z7. Below z7 upstream carries only Natural Earth
+   * glaciers, so a client that draws forest, rock and ice from this layer shows an empty land surface at z5-6 and a
+   * sudden forest at z7. Those zooms are generalized exactly like z7: tiny features dropped by
+   * {@link #MIN_PIXEL_SIZE_THRESHOLDS}, the rest merged in {@link #postProcess}.
+   */
+  public static final int OSM_MIN_ZOOM = 5;
+
   public static final ZoomFunction<Number> MIN_PIXEL_SIZE_THRESHOLDS = ZoomFunction.fromMaxZoomThresholds(Map.of(
     13, 8,
