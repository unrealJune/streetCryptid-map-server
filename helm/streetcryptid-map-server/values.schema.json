{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "streetcryptid-map-server values",
  "type": "object",
  "description": "The privacy boundary (z0-10 raw cutoff, fixed-z10 bundle anchor, z14 max) is compiled into the API image. No Helm value can weaken it; the keys below are explicitly forbidden.",
  "not": {
    "anyOf": [
      { "required": ["maxPublicRawZoom"] },
      { "required": ["privacyAnchorZoom"] },
      { "required": ["allowRawFineTiles"] },
      { "required": ["disablePrivacy"] },
      { "required": ["bundleAnchorZoom"] },
      { "required": ["maxBundleZoom"] }
    ]
  },
  "properties": {
    "replicaCount": { "type": "integer", "const": 1 },
    "strategy": {
      "type": "object",
      "properties": {
        "type": { "type": "string", "const": "Recreate" }
      }
    },
    "image": {
      "type": "object",
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string" },
        "digest": { "type": "string" },
        "pullPolicy": { "type": "string", "enum": ["Always", "IfNotPresent", "Never"] }
      }
    },
    "martin": {
      "type": "object",
      "properties": {
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 }
      }
    },
    "api": {
      "type": "object",
      "properties": {
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "bundleWorkers": { "type": "integer", "minimum": 1 },
        "bundleMaxBuilds": { "type": "integer", "minimum": 1, "maximum": 4 },
        "bundleMaxBytes": { "type": "integer", "minimum": 1 },
        "cache": {
          "type": "object",
          "properties": {
            "dir": { "type": "string" },
            "maxBytes": { "type": "integer", "minimum": 0 }
          }
        }
      }
    },
    "tiles": {
      "type": "object",
      "properties": {
        "dataDir": { "type": "string", "minLength": 1 },
        "manifestURL": { "type": "string" },
        "publicKey": { "type": "string" },
        "retainReleases": { "type": "integer", "minimum": 2 },
        "authSecret": {
          "type": "object",
          "properties": {
            "name": { "type": "string" },
            "key": { "type": "string" }
          }
        },
        "autoUpdate": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "interval": { "type": "string" }
          }
        },
        "bake": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "area": { "type": "string", "minLength": 1 },
            "minZoom": { "type": "integer", "minimum": 0, "maximum": 24 },
            "maxZoom": { "type": "integer", "minimum": 0, "maximum": 24 },
            "languages": { "type": "string" },
            "suspend": { "type": "boolean" },
            "schedule": { "type": "string" },
            "nodeName": { "type": "string" },
            "threads": { "type": "integer", "minimum": 1 },
            "xmx": { "type": "string" },
            "downloadMaxBandwidth": { "type": "string" },
            "lowMemory": { "type": "boolean" },
            "scratch": {
              "type": "object",
              "properties": {
                "size": { "type": "string" },
                "storageClass": { "type": "string" }
              }
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "autoUpdate": { "properties": { "enabled": { "const": true } } } }
          },
          "then": {
            "required": ["manifestURL", "publicKey"],
            "properties": {
              "manifestURL": { "type": "string", "pattern": "^https://" },
              "publicKey": { "type": "string", "minLength": 1 }
            }
          }
        }
      ]
    },
    "service": {
      "type": "object",
      "properties": {
        "type": { "type": "string", "enum": ["ClusterIP", "NodePort", "LoadBalancer"] },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 }
      }
    },
    "ingress": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" }
      }
    }
  }
}
